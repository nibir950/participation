# Node.js 22.12+; run npm run setup to copy this to .env.
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# Local persistence only. No MongoDB, Atlas, or external database is used.
# The path is resolved from the project root. Set HISTORY_FILE= for memory-only mode.
HISTORY_FILE=data/run-history.json

# Gemini API (free tier available for eligible models/accounts).
# Create a key in Google AI Studio, then paste it below. Keep it server-side only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=AQ.Ab8RN6Ji_9YalDd1o8ZH67IuH7Cs4f6moK8QbDbg74R3e7GHeg
# Backward-compatible alternative: LLM_API_KEY=your_key_here
LLM_API_KEY=
# json_schema, json_object, or none (schema remains enforced locally).
LLM_RESPONSE_FORMAT=json_schema
# Optional; blank omits temperature for models that do not support it.
LLM_TEMPERATURE=0
# max_tokens or max_completion_tokens, according to your provider.
LLM_TOKEN_PARAMETER=max_tokens
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_MS=11000
LLM_REQUEST_BUDGET_MS=25000
LLM_RETRIES=1
LLM_CACHE_TTL_MS=300000
LLM_CACHE_SIZE=128
LLM_MAX_CONCURRENCY=6
# Probes a real model before /health becomes ready. Retries every 30s on failure.
LLM_WARMUP=true

# Sample demo bypasses the LLM ONLY on /api/demo/:id, never /optimize-energy.
ENABLE_DEMO=true
# Optional protection for dashboard history (not the public judging API).
# With no token history is disabled in production. Use a long random value.
DASHBOARD_TOKEN=

# Docker Compose uses this as the model base URL override.
LLM_DOCKER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
